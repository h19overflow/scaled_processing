@startuml Table_Extraction_Feature_Class_Diagram

!theme plain
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #F8F9FA
skinparam classBorderColor #6C757D
skinparam arrowColor #495057

title Table Extraction Feature - Class Diagram

class DoclingProcessor {
  - logger: Logger
  - temp_base_dir: Path
  - _converters: Dict<str, DocumentConverter>
  --
  + __init__(temp_base_dir: str)
  + extract_document(raw_file_path: str, document_id: str): Dict<str, Any>
  + _initialize_converters(): Dict<str, DocumentConverter>
  + _detect_document_format(file_path: Path): str
  + _create_processing_directory(document_id: str): Path
  + _get_file_info(file_path: Path, document): Dict<str, Any>
  --
  ' Extracts tables as JSON files
}

class TableFieldMapping {
  + field_name: str
  + english_translation: str
  + table_id: int
  + extraction_path: str
  + example_value: str
  + field_type: str
  + is_required: bool
  --
  + extract_value(tables_data: List<Dict>): Any
  + _extract_by_direct_path(data: List<Dict>, path: str): Any
  + _convert_type(value: Any): Any
}

class TableExtractionConfig {
  + document_type: str
  + description: str
  + field_mappings: List<TableFieldMapping>
  + validation_rules: Dict<str, Any>
  + created_by: str
  + created_at: datetime
  --
  + get_field_mapping(field_name: str): TableFieldMapping
  + extract_all_fields(tables_data: List<Dict>): Dict<str, Any>
  + get_required_fields(): List<str>
}

class TableExtractionResult {
  + document_id: str
  + document_name: str
  + table_extractions: Dict<str, Any>
  + extraction_config: str
  + tables_count: int
  + timestamp: datetime
  --
  + to_extraction_results(): List<Dict<str, Any>>
}

class ExtractionResult {
  + document_id: str
  + document_name: str
  + extraction_class: str
  + extraction_text: str
  + attributes: Dict<str, Any>
  + alignment_status: str
  + extraction_index: int
  + group_index: int
  + description: str
  + char_start_pos: int
  + char_end_pos: int
  + timestamp: datetime
  --
  + get_data(): Dict<str, Any>
  + get_text_length(): int
  + is_valid(): bool
  + is_aligned(): bool
}

class TableStorageService {
  - logger: Logger
  - config_dir: Path
  - _cached_configs: Dict<str, TableExtractionConfig>
  --
  + __init__(config_dir: str)
  + process_table_extraction(document_id: str, document_name: str, processing_dir: Path): List<ExtractionResult>
  + _load_table_data(table_file: Path): List<Dict>
  + _detect_document_type(document_name: str, tables_data: List<Dict>): str
  + _load_table_config(doc_type: str): TableExtractionConfig
  + _extract_and_convert(document_id: str, document_name: str, tables_data: List<Dict>, config: TableExtractionConfig): List<ExtractionResult>
  + create_sample_config(doc_type: str): bool
  --
  ' Document types supported: gspp_billing, tnb_utilities, invoice, general
}

class PipelineState {
  + extractions: Any
  + document_id: str
  + document_name: str
  + processing_directory: str
}

class DatabaseStorageTask {
  + store_in_database(state: PipelineState): Dict<str, Any>
  + _process_table_extractions(state: PipelineState, document_id: str, document_name: str): List<ExtractionResult>
  + _convert_to_uuid(document_id: str): str
  + _create_extraction_result(document_id: str, document_name: str, extraction: Dict): ExtractionResult
}

class ExtractionCRUD {
  + create(result: ExtractionResult): Any
  + read(document_id: str): List<ExtractionResult>
  + update(result: ExtractionResult): bool
  + delete(document_id: str): bool
}

class ConnectionManager {
  + get_connection(): Connection
  + close_connection(): void
}

class TNB_Utilities_Config {
  + document_type: "tnb_utilities"
  + field_mappings: "beban_diisytiharkan_kW, ..."
}

class GSPP_Billing_Config {
  + document_type: "gspp_billing"
  + field_mappings: "puncak_penggunaan, ..."
}

' --- Relationships ---
DoclingProcessor ..> TableStorageService : generates
TableStorageService ..> TableExtractionConfig : loads
TableExtractionConfig *-- TableFieldMapping : contains
TableStorageService ..> TableExtractionResult : creates
TableExtractionResult *-- ExtractionResult : includes
DatabaseStorageTask ..> TableStorageService : uses
DatabaseStorageTask ..> PipelineState : processes
DatabaseStorageTask ..> ExtractionCRUD : stores via
ExtractionCRUD ..> ConnectionManager : uses
TableStorageService ..> TNB_Utilities_Config : loads
TableStorageService ..> GSPP_Billing_Config : loads

' --- Annotations/Notes ---
note right of TableFieldMapping
  Simplified extraction paths:
  • data[0]['Penggunaan']
  • data[4]['Amaun (RM)']
  • data[6]['Jumlah']
end note

note right of TableStorageService
  Detects document types:
  GSPP billing
  TNB utilities
  Invoices
  General
end note

note right of DatabaseStorageTask
  Integrates table extractions with
  existing extraction workflow
end note

@enduml
