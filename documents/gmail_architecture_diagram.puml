@startuml Gmail Architecture Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #6C757D
    HeaderBackgroundColor #E9ECEF
}
skinparam note {
    BackgroundColor #FFF3CD
    BorderColor #FFC107
}

package "FastAPI Application" {
    class FastAPIApp {
        +state.auth_manager: GmailAuthManager
        +state.gmail_service: GmailService
        +lifespan()
        +setup_gmail_watch()
    }

    package "API Dependencies" {
        class Dependencies {
            +get_auth_manager()
            +get_gmail_service()
            +get_optional_gmail_service()
        }
    }
}

package "API Endpoints" as endpoints {
    package "gmail_endpoints/" {
        class GmailAuthRouter {
            +POST /auth/login
            +GET /auth/callback
            +GET /auth/status
            --
            Handles OAuth2 flow
        }

        class GmailServiceRouter {
            +GET /gmail/messages
            +GET /gmail/messages/{id}
            +GET /gmail/messages/{id}/attachments
            +POST /gmail/watch/setup
            +GET /gmail/watch/status
            +GET /gmail/history/{id}
            --
            Gmail API operations
        }

        class GmailMonitoringRouter {
            +GET /gmail/monitor/check-new
            +GET /gmail/monitor/watch-status
            +POST /gmail/monitor/test-notification
            --
            Manual monitoring checks
        }
    }
}

package "Gmail Services" as services {
    package "cloud/" {
        class GmailAuthManager {
            +client_secrets_path: str
            +token_path: str
            +SCOPES: List[str]
            --
            +get_credentials(): Credentials
            +get_authorization_url(): tuple
            +exchange_code_for_tokens(): Credentials
            +get_gmail_service(): Resource
            --
            Manages OAuth2 tokens
            Handles refresh automatically
        }

        class GmailService {
            +auth_manager: GmailAuthManager
            +service: Resource
            --
            +setup_watch(): dict
            +get_history_changes(): dict
            +get_message(): dict
            +extract_message_body(): str
            +process_attachments(): List[Dict]
            +save_attachment(): str
            --
            Core Gmail API operations
        }

        class PubSubSubscriber {
            +project_id: str
            +subscription_name: str
            +gmail_service: GmailService
            --
            +process_gmail_notification()
            +start_listening()
            +_process_history_changes()
            +_process_new_message()
            --
            Handles real-time notifications
        }

        class Models {
            +EmailNotification
            +AttachmentInfo
            +ProcessingResult
            +EmailProcessingStatus
            --
            Pydantic data models
        }
    }
}

package "External Services" as external {
    class GoogleAPIs {
        Gmail API
        OAuth2 Service
    }

    class GoogleCloudPubSub {
        Topic: gmail-notifications
        Subscription: gmail-notifications-subscription
        Project: gmail-monitor-project-472511
    }

    class FileSystem {
        client_secret.json
        token.json
        /attachments/
    }
}

' Relationships - FastAPI App
FastAPIApp --> Dependencies : "uses for DI"
FastAPIApp --> GmailAuthManager : "creates on startup"
FastAPIApp --> GmailService : "creates when authenticated"

' Relationships - API Dependencies
Dependencies --> GmailAuthManager : "injects into endpoints"
Dependencies --> GmailService : "injects into endpoints"

' Relationships - Endpoints to Dependencies
GmailAuthRouter --> Dependencies : "depends on"
GmailServiceRouter --> Dependencies : "depends on"
GmailMonitoringRouter --> Dependencies : "depends on"

' Relationships - Service Layer
GmailService --> GmailAuthManager : "uses for authentication"
PubSubSubscriber --> GmailService : "uses for email processing"
GmailAuthManager --> GoogleAPIs : "authenticates with"
GmailService --> GoogleAPIs : "calls Gmail API"

' Relationships - Data Flow
GmailAuthManager --> FileSystem : "reads/writes tokens"
GmailService --> FileSystem : "saves attachments"
GoogleCloudPubSub --> PubSubSubscriber : "sends notifications"

' Notes
note top of GmailAuthManager
OAuth2 Flow:
1. Loads saved tokens
2. Refreshes if expired
3. Initiates browser flow if needed
4. Saves new tokens to disk
end note

note top of GmailService
Gmail Operations:
1. Setup push notifications
2. Fetch message history
3. Download attachments
4. Extract email content
end note

note top of PubSubSubscriber
Real-time Processing:
1. Receives Pub/Sub notifications
2. Fetches new messages
3. Processes attachments
4. Saves to filesystem
end note

note top of GoogleCloudPubSub
Push Notifications:
When emails arrive in INBOX,
Google sends notifications to
our Pub/Sub topic
end note

' Authentication Flow
note as AuthFlow
**Authentication Flow:**
1. User calls /auth/login
2. Redirected to Google OAuth
3. User grants permissions
4. Google redirects to /auth/callback
5. Exchange code for tokens
6. Save tokens to filesystem
7. Initialize Gmail service
8. Setup push notifications
end note

' Data Flow
note as DataFlow
**Email Processing Flow:**
1. Email arrives in Gmail INBOX
2. Google sends Pub/Sub notification
3. PubSubSubscriber receives notification
4. Fetches email via Gmail API
5. Downloads and saves attachments
6. Processes email content
end note

@enduml