@startuml Structured Extraction Pipeline Sequence
title Structured Extraction Pipeline - Complete Flow

actor User
participant "API/FileWatcher" as API
participant "Classification Node" as Classification
participant "Chunking Node" as Chunking
participant "Preference Injection" as Preferences
participant "Context Loading" as Context
participant "Discovery Node" as Discovery
participant "Consolidation Node" as Consolidation
participant "Config Generation" as ConfigGen
participant "Extraction Node" as Extraction
database "PostgreSQL" as DB
participant "AI Model (Gemini)" as AI

== Document Processing Initialization ==
User -> API: Upload Document
API -> Classification: process_document(content)
Classification -> AI: classify_document(content)
AI --> Classification: classification + confidence
Classification --> API: {classification: "contract", confidence: 0.9}

== Document Chunking ==
API -> Chunking: chunk_document(state, settings)
note right of Chunking
  - Max tokens: 5128
  - Overlap: 200 tokens
  - Uses tiktoken encoding
end note
Chunking -> Chunking: _create_chunks(text, config)
Chunking -> Chunking: _tiktoken_chunk(text, max_tokens, overlap)
Chunking --> API: {chunks: [chunk1, chunk2, chunk3], status: "chunked"}

== User Context Enhancement ==
API -> Preferences: inject_user_preferences(state)
Preferences -> DB: get_user_preferences(user_id, classification)
note right of DB
  Query: SELECT field_preferences, 
         extraction_style, prompt_instructions
  WHERE user_id = 'test_user' 
  AND classification = 'contract'
end note
DB --> Preferences: user_preferences{field_priorities, extraction_style, prompt_instructions}
Preferences --> API: {user_preferences: {...}, status: "preferences_loaded"}

API -> Context: load_feedback_context(state)
Context -> DB: get_feedback_by_classification(classification, user_id, limit=5)
note right of DB
  Query: SELECT feedback_type, comment, 
         fields, rating
  FROM document_feedback
  WHERE classification = 'contract'
  ORDER BY rating DESC LIMIT 5
end note
DB --> Context: feedback_records[5]
Context -> Context: build_feedback_context(records)
Context --> API: {feedback_context: {relevant_feedback, common_issues}, status: "context_loaded"}

== AI-Powered Field Discovery ==
API -> Discovery: sequential_discovery(enhanced_state, settings)

loop For each chunk (3 chunks)
    Discovery -> Discovery: create_discovery_agent(model)
    Discovery -> Discovery: build_enhanced_prompt(chunk, preferences, context, previous_discoveries)
    note right of Discovery
      Enhanced prompt includes:
      - User preferences (field priorities)
      - Feedback context (common issues)
      - Previous chunk discoveries
      - Classification-specific instructions
    end note
    
    Discovery -> AI: analyze_chunk(enhanced_prompt)
    note right of AI
      Model: gemini-2.0-flash
      Task: Discover extractable fields
      Context: Contract classification
      Preferences: Employment terms focus
    end note
    AI --> Discovery: progressive_schema{discovered_fields, document_type, confidence}
    Discovery -> Discovery: accumulate_discoveries(progressive_schema)
end

Discovery --> API: {progressive_results: [schema1, schema2, schema3], status: "discovery_complete"}

== Schema Consolidation ==
API -> Consolidation: consolidate_schemas(progressive_results)
Consolidation -> AI: merge_and_validate_schemas(progressive_results)
AI --> Consolidation: consolidated_schema{unified_fields, deduplicated}
Consolidation --> API: {consolidated_schema: {...}, status: "consolidated"}

== Extraction Configuration ==
API -> ConfigGen: generate_extraction_config(consolidated_schema)
ConfigGen -> ConfigGen: calculate_agent_scaling(schema_complexity)
ConfigGen -> ConfigGen: optimize_task_distribution(fields)
ConfigGen --> API: {extraction_config: {agent_count, task_distribution}, status: "config_ready"}

== Field Extraction Execution ==
API -> Extraction: execute_extraction(document, schema, config)

loop For each field group (parallel processing)
    Extraction -> AI: extract_fields(document_section, field_specs)
    AI --> Extraction: extracted_values{field_name: value, confidence: score}
end

Extraction -> Extraction: validate_extraction_results(extracted_values)
Extraction --> API: {extractions: {field_values}, status: "extraction_complete"}

== Results Storage and Response ==
API -> DB: save_extraction_results(document_id, extractions, schema)
DB --> API: saved_successfully
API --> User: {document_id, status: "completed", extracted_fields: {...}}

== Error Handling Flows ==
note over Classification, Extraction
  Each node includes fallback mechanisms:
  - Classification: Default to "document"
  - Chunking: Basic text splitting
  - Preferences: Use default preferences  
  - Context: Continue without feedback
  - Discovery: Use fallback basic schema
  - Extraction: Return partial results
end note

@enduml