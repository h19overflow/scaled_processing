@startuml Pipeline_Overview
' Modern look and clarity
skinparam rectangle {
  BackgroundColor #F5F5F5
  BorderColor Navy
  FontColor Black
  RoundCorner 15
  Shadowing true
}
skinparam arrow {
  Color DarkBlue
  FontColor Navy
  Thickness 3
}

skinparam note {
  BackgroundColor #FEF9E7
  BorderColor Orange
  FontColor Black
  Shadowing true
}

' Input node - special shape/color
rectangle "<b><size:15>🗎 Document Input</size></b>\n(document_text, document_id, user_id)" as input #99FF99

rectangle "<b><size:15>🔎 Classification</size></b>\nAgent: ClassificationAgent\nInput: document_text\nOutput: classification, confidence" as classify #AED6F1

rectangle "<b><size:15>🧩 Feedback Context</size></b>\nNode: load_feedback_context\nInput: classification\nOutput: feedback_context" as feedback #D6EAF8

rectangle "<b><size:15>👤 User Preferences</size></b>\nNode: inject_user_preferences\nInput: feedback_context\nOutput: user_preferences" as preferences #D4EFDF

rectangle "<b><size:15>📃 Document Chunking</size></b>\nNode: chunk_document\nInput: document_text\nOutput: chunks[]" as chunking #FAD7A0

rectangle "<b><size:15>🧭 Field Discovery</size></b>\nNode: sequential_discovery\nInput: chunks[]\nOutput: progressive_results[]" as discovery #F9E79F

rectangle "<b><size:15>⚙️ Config Generation</size></b>\nNode: generate_config\nInput: progressive_results[]\nOutput: extraction_config" as config #E8DAEF

rectangle "<b><size:15>🎯 Data Extraction</size></b>\nNode: extract_data\nInput: document_text, extraction_config\nOutput: extractions[]" as extraction #FADBD8

' Output node - special shape/color
rectangle "<b><size:15>📋 Final Results</size></b>\n(extractions[], classification, chunks[], progressive_results[])" as results #FFB3BA

input -down-> classify : <b>document_text</b>
classify -down-> feedback : <b>classification</b>
feedback -down-> preferences : <b>feedback_context</b>
preferences -down-> chunking : <b>user_preferences</b>
chunking -down-> discovery : <b>chunks[]</b>
discovery -down-> config : <b>progressive_results[]</b>
config -down-> extraction : <b>extraction_config</b>
extraction -down-> results : <b>extractions[]</b>

note right of discovery
  <b>Progressive Results:</b>
  - discovered_fields[]
  - <i>field_name, field_type</i>
  - description, sample_values
end note

note right of config
  <b>Extraction Config:</b>
  - extraction prompt
  - field examples
  - model configuration
  - extraction_classes[]
end note

note right of extraction
  <b>Uses langextract library:</b>
  - LLM-powered extraction
  - Filters invalid results
  - Returns structured data
end note

@enduml
