@startuml structured_extraction_actual_code_architecture
title Actual Structured Extraction Pipeline - Code Structure & Relationships

!define MODEL_COLOR #E8F4FD
!define CONFIG_COLOR #FFF2CC
!define AGENT_COLOR #D5E8D4
!define NODE_COLOR #F8CECC
!define GRAPH_COLOR #E1D5E7
!define EXTERNAL_COLOR #DDDDD

' ================================
' PACKAGE STRUCTURE
' ================================

package "structured_extraction/" as root_package {

    ' ================================
    ' MODELS LAYER
    ' ================================
    package "models/" as models_package MODEL_COLOR {
        class "document.py" as document_models {
            + DocumentChunk (dataclass)
            - chunk_id: int
            - text: str  
            - start_char: int
            - end_char: int
            - token_count: int
            --
            + DocumentSchema (BaseModel)
            - document_type: str
            - extraction_classes: List[FieldSchema]
            - extraction_prompt: str
        }
        
        class "schema.py" as schema_models {
            + FieldSchema (BaseModel)
            - field_name: str
            - field_type: str
            - description: str
            - example_text: str
            - category: str
            - subcategory: str
            --
            + ProgressiveSchema (BaseModel)
            - discovered_fields: List[FieldSchema]
            - document_type: str
            - confidence_level: str
            - chunk_coverage: int
            --
            + ConsolidatedSchema (BaseModel)
            - final_fields: List[FieldSchema]
            - document_type: str
            - optimization_notes: str
            - extraction_prompt: str
        }
        
        class "state.py" as state_models {
            + MultiAgentState (TypedDict)
            - document_text: str
            - document_id: str
            - chunks: List[DocumentChunk]
            - progressive_results: List[ProgressiveSchema]
            - consolidated_schema: ConsolidatedSchema
            - final_schema: DocumentSchema
            - config: Dict[str, Any]
            - extractions: List[Dict[str, Any]]
            - status: str
            - error: str
        }

        class "__init__.py" as models_init {
            exports:
            - DocumentChunk, DocumentSchema
            - FieldSchema, ProgressiveSchema, ConsolidatedSchema  
            - MultiAgentState
        }
    }

    ' ================================
    ' CONFIG LAYER
    ' ================================
    package "config/" as config_package CONFIG_COLOR {
        class "models.py" as config_models {
            + ChunkingConfig (BaseModel)
            - max_tokens: int = 1500
            - overlap_tokens: int = 200
            - use_tiktoken: bool = True
            --
            + ModelConfig (BaseModel)
            - discovery_model: str = "gemini-2.0-flash"
            - consolidation_model: str = "gemini-2.0-flash"
            - extraction_model: str = "gemini-2.5-flash"
            - openai_api_key: Optional[str]
            --
            + ExtractionConfig (BaseModel)
            - max_fields: int = 8
            - document_type: str = "unknown"
            - output_dir: str = "demo_results"
        }
        
        class "settings.py" as settings {
            + Settings (BaseModel)
            - chunking: ChunkingConfig
            - models: ModelConfig
            - extraction: ExtractionConfig
            --
            + create_default() -> Settings
            + get_output_path(filename) -> Path
            + __init__(**data)
        }

        class "__init__.py" as config_init {
            exports:
            - Settings
            - ChunkingConfig, ModelConfig, ExtractionConfig
        }
    }

    ' ================================
    ' AGENTS LAYER
    ' ================================
    package "agents/" as agents_package AGENT_COLOR {
        class "discovery.py" as discovery_agent {
            + SequentialDiscoveryDeps (BaseModel)
            - chunk_text: str
            - chunk_id: int
            - previous_discoveries: List[FieldSchema]
            - document_type: str
            --
            + create_discovery_agent(model_name) -> Agent
            + discovery_prompt(ctx) -> str
        }
        
        class "consolidation.py" as consolidation_agent {
            + ConsolidationDeps (BaseModel)
            - discovered_fields: List[FieldSchema]
            - document_type: str
            - max_fields: int = 8
            --
            + create_consolidation_agent(model_name) -> Agent
            + consolidation_prompt(ctx) -> str
        }

        class "__init__.py" as agents_init {
            exports:
            - create_discovery_agent, SequentialDiscoveryDeps
            - create_consolidation_agent, ConsolidationDeps
        }
    }

    ' ================================
    ' NODES LAYER
    ' ================================
    package "nodes/" as nodes_package NODE_COLOR {
        class "chunking.py" as chunking_node {
            + chunk_document(state, settings) -> MultiAgentState
            + _create_chunks(text, document_id, config) -> List[DocumentChunk]
            + _tiktoken_chunk(text, max_tokens, overlap_tokens) -> List[DocumentChunk]
            + _simple_chunk(text, max_tokens, overlap_tokens) -> List[DocumentChunk]
            + _token_to_char_position(text, tokens, token_index, encoding) -> int
        }
        
        class "discovery.py" as discovery_node {
            + sequential_discovery(state, settings) -> MultiAgentState
            + _create_fallback_schema(chunks) -> List[ProgressiveSchema]
        }
        
        class "consolidation.py" as consolidation_node {
            + consolidate_schema(state, settings) -> MultiAgentState
            + _get_all_fields(progressive_results) -> List[FieldSchema]
            + _to_document_schema(consolidated) -> DocumentSchema
            + _simple_consolidation(fields, document_type, max_fields) -> ConsolidatedSchema
        }
        
        class "config_gen.py" as config_gen_node {
            + generate_config(state, settings) -> MultiAgentState
            + _create_config(schema, sample_text, model_id) -> Dict[str, Any]
            + _format_extraction_classes(classes) -> str
            + _create_examples(extraction_classes, sample_text) -> List
        }
        
        class "extraction.py" as extraction_node {
            + extract_data(state, settings) -> MultiAgentState
            + _extract_with_langextract(state) -> List[Dict[str, Any]]
            + _mock_extractions(state) -> List[Dict[str, Any]]
        }

        class "__init__.py" as nodes_init {
            exports:
            - chunk_document, sequential_discovery
            - consolidate_schema, generate_config, extract_data
        }
    }

    ' ================================
    ' GRAPH ORCHESTRATOR
    ' ================================
    class "graph.py" as graph_orchestrator GRAPH_COLOR {
        + build_graph(settings: Settings) -> CompiledGraph
        + create_initial_state(document_text, document_id) -> MultiAgentState
        --
        Workflow Steps:
        1. chunk_document -> sequential_discovery
        2. sequential_discovery -> consolidate_schema  
        3. consolidate_schema -> generate_config
        4. generate_config -> extract_data
        5. extract_data -> END
    }

    ' ================================
    ' MAIN ENTRY POINT  
    ' ================================
    class "__init__.py" as main_init {
        + run_extraction(document_text, document_id, settings) -> MultiAgentState
        + run_extraction_sync(document_text, document_id, settings) -> MultiAgentState
        + load_document(file_path) -> str
        + save_results(results, output_dir) -> Dict[str, str]
        + _serialize_schema(schema) -> Dict[str, Any]
        + _generate_summary(results) -> str
    }

    ' ================================
    ' LEGACY/PLACEHOLDER FILES
    ' ================================
    class "field_discovery_agent.py" as legacy_file EXTERNAL_COLOR {
        # FieldDiscoveryAgent - Auto-detect extractable fields
        (Legacy placeholder file)
    }
}

' ================================
' EXTERNAL DEPENDENCIES
' ================================
package "External Libraries" as external EXTERNAL_COLOR {
    [LangGraph] as langgraph
    [Pydantic AI] as pydantic_ai
    [TikToken] as tiktoken
    [LangExtract] as langextract
    [Pydantic] as pydantic
}

' ================================
' RELATIONSHIPS & DEPENDENCIES
' ================================

' Models relationships
state_models --> document_models : imports DocumentChunk, DocumentSchema
state_models --> schema_models : imports ProgressiveSchema, ConsolidatedSchema
models_init --> document_models : exports
models_init --> schema_models : exports  
models_init --> state_models : exports

' Config relationships
settings --> config_models : imports ChunkingConfig, ModelConfig, ExtractionConfig
config_init --> settings : exports
config_init --> config_models : exports

' Agents relationships
discovery_agent --> schema_models : imports FieldSchema, ProgressiveSchema
consolidation_agent --> schema_models : imports FieldSchema, ConsolidatedSchema
agents_init --> discovery_agent : exports
agents_init --> consolidation_agent : exports

' Nodes relationships
chunking_node --> state_models : imports MultiAgentState
chunking_node --> document_models : imports DocumentChunk
chunking_node --> settings : imports Settings
discovery_node --> state_models : imports MultiAgentState
discovery_node --> schema_models : imports FieldSchema, ProgressiveSchema
discovery_node --> discovery_agent : uses create_discovery_agent
consolidation_node --> state_models : imports MultiAgentState
consolidation_node --> schema_models : imports FieldSchema, ConsolidatedSchema
consolidation_node --> document_models : imports DocumentSchema
consolidation_node --> consolidation_agent : uses create_consolidation_agent
config_gen_node --> state_models : imports MultiAgentState
config_gen_node --> schema_models : imports FieldSchema
extraction_node --> state_models : imports MultiAgentState
nodes_init --> chunking_node : exports
nodes_init --> discovery_node : exports
nodes_init --> consolidation_node : exports
nodes_init --> config_gen_node : exports
nodes_init --> extraction_node : exports

' Graph relationships
graph_orchestrator --> state_models : imports MultiAgentState
graph_orchestrator --> settings : imports Settings
graph_orchestrator --> nodes_init : imports all node functions

' Main entry point relationships
main_init --> settings : imports Settings
main_init --> graph_orchestrator : imports build_graph, create_initial_state
main_init --> state_models : imports MultiAgentState

' External dependencies
discovery_agent --> pydantic_ai : uses Agent, RunContext
consolidation_agent --> pydantic_ai : uses Agent, RunContext
chunking_node --> tiktoken : optional import
extraction_node --> langextract : optional import
graph_orchestrator --> langgraph : imports StateGraph, END
config_models --> pydantic : uses BaseModel, Field
schema_models --> pydantic : uses BaseModel
settings --> pydantic : uses BaseModel, Field

' ================================
' WORKFLOW EXECUTION FLOW
' ================================
note bottom of graph_orchestrator
    **LangGraph Workflow Execution:**
    
    1. **chunk_document**: Splits document into token-based chunks
       • Uses TikToken if available, falls back to character-based
       • Configurable max_tokens (1500) and overlap_tokens (200)
    
    2. **sequential_discovery**: Progressive schema discovery per chunk
       • Uses Gemini 2.0 Flash model for field identification
       • Each chunk builds on previous discoveries
       • Fallback schema if AI fails
    
    3. **consolidate_schema**: Merge and optimize discovered fields
       • Uses Gemini 2.0 Flash for deduplication and prioritization  
       • Limits to max_fields (8) most valuable extractions
       • Simple deduplication fallback
    
    4. **generate_config**: Create LangExtract configuration
       • Converts schema to prompts and examples
       • Uses Gemini 2.5 Flash for final extraction
       • Mock examples if LangExtract unavailable
    
    5. **extract_data**: Final structured data extraction
       • Uses LangExtract library with generated config
       • Validates and filters empty/invalid extractions
       • Mock data fallback for testing
end note

note top of main_init
    **Entry Points for Integration:**
    
    • **run_extraction()**: Async function perfect for Prefect flows
    • **run_extraction_sync()**: Sync wrapper for simple use cases
    • **load_document()**: File loading utility
    • **save_results()**: JSON + Markdown output formatting
    
    **Configuration-Driven:**
    • All hardcoded values moved to Settings class
    • Environment variable integration
    • Validation via Pydantic models
end note

@enduml