@startuml structured_extraction_sequence
!theme plain
title Structured Extraction Pipeline - Sequence Diagram

actor User
participant "Graph Orchestrator" as Graph
participant "Classification Service" as Classifier
participant "Feedback Context" as Feedback
participant "Preference Manager" as Preferences
participant "Document Chunker" as Chunker
participant "Sequential Discovery" as Discovery
participant "Schema Consolidator" as Consolidator
participant "Config Generator" as ConfigGen
participant "Data Extractor" as Extractor
database "Database" as DB

User -> Graph: Process document(text, doc_id, user_id)
activate Graph

== Classification Phase ==
Graph -> Classifier: classify_document(text, doc_id, user_id)
activate Classifier
Classifier -> Classifier: Try LLM classification (Gemini 2.0 Flash)
alt LLM confidence >= 0.7
    Classifier -> Classifier: Use LLM result
else LLM confidence < 0.7
    Classifier -> Classifier: Fallback to keyword matching
end
Classifier -> DB: Store classification result
Classifier --> Graph: Classification result
deactivate Classifier

== Feedback Context Loading ==
Graph -> Feedback: load_feedback_context(doc_id, user_id, classification)
activate Feedback
Feedback -> DB: Get historical feedback
Feedback --> Graph: Feedback context
deactivate Feedback

== User Preference Injection ==
Graph -> Preferences: inject_user_preferences(user_id, classification)
activate Preferences
Preferences -> DB: Get user preferences
Preferences -> Preferences: Generate preference prompt injection
Preferences --> Graph: Enhanced state with preferences
deactivate Preferences

== Document Processing ==
Graph -> Chunker: chunk_document(text, settings)
activate Chunker
Chunker -> Chunker: Split document into chunks
Chunker --> Graph: Document chunks
deactivate Chunker

== Schema Discovery ==
Graph -> Discovery: sequential_discovery(chunks, settings)
activate Discovery
loop For each chunk
    Discovery -> Discovery: Analyze chunk structure
    Discovery -> Discovery: Identify potential fields
end
Discovery --> Graph: Progressive results
deactivate Discovery

== Schema Consolidation ==
Graph -> Consolidator: consolidate_schema(progressive_results)
activate Consolidator
Consolidator -> Consolidator: Merge discovered schemas
Consolidator -> Consolidator: Remove duplicates
Consolidator -> Consolidator: Prioritize fields
Consolidator -> Preferences: apply_preferences_to_schema(schema, preferences)
activate Preferences
Preferences -> Preferences: Apply field priorities
Preferences -> Preferences: Apply field mappings
Preferences -> Preferences: Apply extraction rules
Preferences --> Consolidator: Modified schema
deactivate Preferences
Consolidator --> Graph: Consolidated schema
deactivate Consolidator

== Configuration Generation ==
Graph -> ConfigGen: generate_config(consolidated_schema, preferences)
activate ConfigGen
ConfigGen -> ConfigGen: Create extraction configuration
ConfigGen -> Preferences: generate_preference_prompt_injection(preferences)
activate Preferences
Preferences --> ConfigGen: Prompt injection text
deactivate Preferences
ConfigGen --> Graph: Final extraction config
deactivate ConfigGen

== Data Extraction ==
Graph -> Extractor: extract_data(config, document_text)
activate Extractor
Extractor -> Extractor: Apply extraction config
Extractor -> Extractor: Execute field extractions
Extractor -> Extractor: Validate results
Extractor --> Graph: Extracted data
deactivate Extractor

Graph --> User: Final extraction results
deactivate Graph

@enduml